# Wildhaven API settings. Copy to .env next to docker-compose.yml and fill in the first two.
# Everything not listed here keeps its default (see README.md).

# The Google OAuth "Web" client id (it is public; several may be comma-separated).
GOOGLE_CLIENT_IDS=
# Shown on /privacy and /account/delete.
CONTACT_EMAIL=
# The Capacitor Android app's origin. Add http://localhost:5173 for browser development.
ALLOWED_ORIGINS=https://localhost
# Versus match lengths offered to players (minutes). Drop 90,120 if the phone soak test fails.
VERSUS_LENGTHS=30,60,90,120

# Optional extra lock: only these Google emails may sign in (comma-separated, case-insensitive).
# ALLOWED_EMAILS=you@example.com,friend.parent@example.com

# Only when Caddy runs in Docker (docker-compose.caddynet.yml): the network your Caddy container uses.
# CADDY_NETWORK=caddy
